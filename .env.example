NODE_ENV=development
PORT=3000

# MySQL connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=pingpolicy
DB_USER=root
DB_PASSWORD=replace_me
DB_CONNECTION_LIMIT=10
# Set to true when connecting to cloud-managed MySQL instances (e.g., Aiven, PlanetScale, TiDB, Render)
DB_SSL=false

# Optional comma-separated origins for browser-based dashboard clients
CORS_ORIGINS=http://localhost:5173
